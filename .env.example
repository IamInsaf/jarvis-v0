OLLAMA_MODEL=qwen3.5:4b
OLLAMA_THINK=0
OLLAMA_NUM_CTX=8192
# unload the model after this many idle minutes (0 = never); "turn off your brain" unloads it at once
BRAIN_IDLE_MINUTES=10
WHISPER_MODEL=small.en
WHISPER_DEVICE=auto
PIPER_VOICE=voices/en_GB-alan-medium.onnx
SEARXNG_URL=http://localhost:8080
USER_TITLE=sir

# Live dashboard at http://127.0.0.1:8766 while JARVIS runs
HUD_ENABLED=true
HUD_PORT=8766
# Desktop orb: always on top, with live captions and YES/NO buttons (needs the HUD); idle = dim, hide or show
ORB_ENABLED=true
ORB_SIZE=120
ORB_CAPTIONS=true
ORB_IDLE=dim

# Wake word: lower WAKE_THRESHOLD if "Hey Jarvis" misses you (debug_wake.py suggests a value), or run
# enroll_wake.py to train a verifier on your own voice (used automatically once WAKE_VERIFIER exists)
WAKE_THRESHOLD=0.5
WAKE_VERIFIER=data/wake_verifier.pkl
WAKE_VERIFIER_THRESHOLD=0.2

# Listening: Silero voice detection, and talking over JARVIS to interrupt it (no wake word needed)
VAD_THRESHOLD=0.5
CONTINUE_SECONDS=1.5
BARGE_IN=true
BARGE_IN_MARGIN=2.5

# Say the day's briefing unprompted at this time every day, e.g. 07:30 (empty = only when asked)
BRIEFING_TIME=

# Cloud router: leave false for 100% local
CLOUD_ENABLED=false
CLOUD_CONFIRM=true
ANTHROPIC_API_KEY=
